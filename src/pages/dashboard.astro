---
import Layout from '../layouts/Layout.astro';
import NavHeader from '../components/NavHeader.astro';
import KpiGrid from '../components/KpiGrid.astro';
import PlatformCards from '../components/PlatformCards.astro';
import ChatSandbox from '../components/ChatSandbox.astro';
import SeoStudio from '../components/SeoStudio.astro';
import BookingsTable from '../components/BookingsTable.astro';
import FlowBuilder from '../components/FlowBuilder.astro';
import WebChatWidget from '../components/WebChatWidget.astro';
import AgentPersonaStudio from '../components/AgentPersonaStudio.astro';
---

<Layout title="أورا للتسويق | لوحة تحكم التاجر - هالة AI OS">
  <NavHeader />

  <main class="flex-1 max-w-7xl w-full mx-auto p-6 space-y-8">
    <!-- Hero Aura Banner: Merchant Dashboard -->
    <div class="aura-card rounded-2xl p-7 bg-gradient-to-l from-blue-50/80 via-white to-white relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border-blue-100 gsap-reveal">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-blue-700 bg-blue-100/70 px-3 py-1 rounded-md">
          <span>✨ من الإبداع إلى الذكاء | From Creativity to Intelligence</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">
          لوحة تحكم التاجر — <span class="aura-gradient-text font-black">هالة AI OS</span> 👋
        </h1>
        <p class="text-gray-600 text-sm font-bold leading-relaxed">
          إدارة الذكاء ومزامنة الـ RAG وصياغة محتوى السيو للمتجر
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button onclick="triggerIngest()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl text-xs font-bold flex items-center gap-2 shadow-md transition">
          <span class="material-symbols-outlined text-base text-cyan-300">sync</span>
          <span>مزامنة RAG المعرفة</span>
        </button>
      </div>
    </div>

    <!-- ── Quick Merchant Actions Toolbar ──────────────────────── -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3.5 gsap-reveal">
      <button onclick="scrollToSection('sandboxDemo')" class="p-3.5 bg-white border border-emerald-200 hover:border-emerald-500 rounded-2xl shadow-sm text-right space-y-1 transition group">
        <span class="material-symbols-outlined text-emerald-600 text-xl group-hover:scale-110 transition">chat</span>
        <span class="font-bold text-xs text-gray-900 block">تجربة البوت الحية</span>
        <span class="text-[10px] text-gray-500 block">ردود خاطفة &lt; 1ms</span>
      </button>

      <button onclick="scrollToSection('seoStudioBox')" class="p-3.5 bg-white border border-purple-200 hover:border-purple-500 rounded-2xl shadow-sm text-right space-y-1 transition group">
        <span class="material-symbols-outlined text-purple-600 text-xl group-hover:scale-110 transition">edit_note</span>
        <span class="font-bold text-xs text-gray-900 block">صياغة محتوى السيو</span>
        <span class="text-[10px] text-gray-500 block">جودة &gt; 92%</span>
      </button>

      <button onclick="scrollToSection('bookingsBox')" class="p-3.5 bg-white border border-amber-200 hover:border-amber-500 rounded-2xl shadow-sm text-right space-y-1 transition group">
        <span class="material-symbols-outlined text-amber-600 text-xl group-hover:scale-110 transition">calendar_month</span>
        <span class="font-bold text-xs text-gray-900 block">تذاكر الاستشارات</span>
        <span class="text-[10px] text-gray-500 block">تذكير 30د بالواتساب</span>
      </button>

      <button onclick="scrollToSection('platformCardsBox')" class="p-3.5 bg-white border border-cyan-200 hover:border-cyan-500 rounded-2xl shadow-sm text-right space-y-1 transition group">
        <span class="material-symbols-outlined text-cyan-600 text-xl group-hover:scale-110 transition">hub</span>
        <span class="font-bold text-xs text-gray-900 block">ربط سلة وزد وواتساب</span>
        <span class="text-[10px] text-gray-500 block">1-Click OAuth</span>
      </button>

      <a href="/admin" class="p-3.5 bg-white border border-slate-300 hover:border-slate-600 rounded-2xl shadow-sm text-right space-y-1 transition group">
        <span class="material-symbols-outlined text-slate-700 text-xl group-hover:scale-110 transition">admin_panel_settings</span>
        <span class="font-bold text-xs text-gray-900 block">لوحة الإشراف للأدمن</span>
        <span class="text-[10px] text-gray-500 block">Super Admin Portal</span>
      </a>

      <button onclick="triggerIngest()" class="p-3.5 bg-gradient-to-br from-blue-600 to-blue-800 text-white rounded-2xl shadow-md text-right space-y-1 transition group hover:shadow-lg">
        <span class="material-symbols-outlined text-cyan-300 text-xl group-hover:rotate-180 transition duration-500">sync</span>
        <span class="font-bold text-xs block">مزامنة RAG المعرفة</span>
        <span class="text-[10px] text-blue-200 block">تحديث فوري ⚡</span>
      </button>
    </div>

    <!-- ── Interactive RAG Sync Status Modal ────────────────────── -->
    <div id="ragSyncModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="aura-card rounded-3xl p-7 bg-white max-w-lg w-full space-y-5 shadow-2xl text-right relative">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-600 text-xl">sync</span>
            <h3 class="font-bold text-base text-gray-900">مزامنة RAG المعرفة وتحديث الذكاء الاصطناعي</h3>
          </div>
          <button onclick="closeRagModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">✕</button>
        </div>

        <div class="space-y-4">
          <div class="p-4 bg-blue-50/60 rounded-2xl border border-blue-100 space-y-3">
            <div class="flex items-center justify-between text-xs font-bold text-blue-900">
              <span id="ragStepText">جاري سحب بيانات المنتجات والسياسات... ⚡</span>
              <span id="ragPct">0%</span>
            </div>
            <div class="w-full bg-blue-200 rounded-full h-2 overflow-hidden">
              <div id="ragBar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <div class="space-y-2 text-xs text-gray-600 font-medium">
            <div class="flex items-center gap-2">
              <span id="checkStep1" class="material-symbols-outlined text-gray-300 text-base">check_circle</span>
              <span>سحب مواصفات ومنتجات سلة وزد التلقائية</span>
            </div>
            <div class="flex items-center gap-2">
              <span id="checkStep2" class="material-symbols-outlined text-gray-300 text-base">check_circle</span>
              <span>بناء الفهرس المعرفي والكاش السريع بـ KV (5ms)</span>
            </div>
            <div class="flex items-center gap-2">
              <span id="checkStep3" class="material-symbols-outlined text-gray-300 text-base">check_circle</span>
              <span>تحديث ذاكرة البوت بـ اللهجة السعودية البيضاء</span>
            </div>
          </div>
        </div>

        <button onclick="closeRagModal()" id="ragFinishBtn" class="w-full aura-btn-primary py-3 rounded-xl text-xs font-bold hidden">
          تمت المزامنة بنجاح! إغلاق النافذة 🎉
        </button>
      </div>
    </div>

    <div class="gsap-reveal"><KpiGrid /></div>
    <div id="personaStudioBox" class="gsap-reveal"><AgentPersonaStudio /></div>
    <div id="flowBuilderBox" class="gsap-reveal"><FlowBuilder /></div>
    <div id="platformCardsBox" class="gsap-reveal"><PlatformCards /></div>
    <div id="sandboxDemo" class="gsap-reveal"><ChatSandbox /></div>
    <div id="seoStudioBox" class="gsap-reveal"><SeoStudio /></div>
    <div id="bookingsBox" class="gsap-reveal"><BookingsTable /></div>
  </main>

  <WebChatWidget />

  <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500 space-y-1 mt-12">
    <p>حقوق الطبع والنشر © 2026 <strong>أورا للتسويق (Aura Marketing)</strong> — جميع الحقوق محفوظة.</p>
    <p class="text-gray-400">مستقبل التسويق الذكي | From Creativity to Intelligence</p>
  </footer>

  <script is:inline>
    async function sendSandboxMessage() {
      const input = document.getElementById('sandboxInput');
      const text = input.value.trim();
      if (!text) return;

      const chatStream = document.getElementById('chatStream');
      const storeId = document.getElementById('storeSelector').value;
      const dialect = document.getElementById('dialectSelect').value;

      chatStream.innerHTML += `
        <div class="flex items-start justify-end gap-2.5">
          <div class="bg-blue-600 text-white p-3 rounded-2xl rounded-tl-none text-xs leading-relaxed max-w-[85%] shadow-sm">
            ${text}
          </div>
        </div>
      `;
      input.value = '';
      chatStream.scrollTop = chatStream.scrollHeight;

      try {
        const res = await fetch('/api/store/sandbox', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ storeId, message: text, dialect })
        });
        const data = await res.json();
        
        const reply = data.reply || data.error || 'تم استقبال الرسالة بنجاح.';
        const sourceBadge = data.source ? `<span class="text-[10px] text-gray-400 block mt-1">مصدر الرد: ${data.source} (${data.latency || 'AI'})</span>` : '';

        chatStream.innerHTML += `
          <div class="flex items-start gap-2.5 max-w-[85%]">
            <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-bold shrink-0 shadow-sm">
              أ
            </div>
            <div class="bg-white border border-gray-200 p-3 rounded-2xl rounded-tr-none text-xs text-gray-800 shadow-sm leading-relaxed">
              ${reply}
              ${sourceBadge}
            </div>
          </div>
        `;
        chatStream.scrollTop = chatStream.scrollHeight;
      } catch (err) {
        console.error('Sandbox error:', err);
      }
    }

    async function addCustomFaq() {
      const q = document.getElementById('faqQuestion').value.trim();
      const a = document.getElementById('faqAnswer').value.trim();
      const storeId = document.getElementById('storeSelector').value;
      const dialect = document.getElementById('dialectSelect').value;

      if (!q || !a) {
        alert('أدخل السؤال والجواب أولاً.');
        return;
      }

      try {
        const res = await fetch('/api/store/ingest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ storeId, items: [{ question: q, answer: a, dialect }] })
        });
        const data = await res.json();
        if (data.ok) {
          alert('تم حفظ السؤال والجواب فوراً في RAG المتجر! ✅');
          document.getElementById('faqQuestion').value = '';
          document.getElementById('faqAnswer').value = '';
        }
      } catch (err) {
        alert('حدث خطأ أثناء الحفظ');
      }
    }

    async function generateCopy() {
      const name = document.getElementById('copyName').value.trim();
      const price = document.getElementById('copyPrice').value.trim();
      const features = document.getElementById('copyFeatures').value.trim();

      if (!name) {
        alert('يرجى كتابة اسم المنتج أولاً.');
        return;
      }

      const copyOutput = document.getElementById('copyOutput');
      copyOutput.innerText = 'جاري توليد الوصف والسيو وتقييم الجودة من الذكاء الاصطناعي... ⏳';

      try {
        const res = await fetch('/api/copy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price, features })
        });
        const data = await res.json();
        if (data.ok && data.copywriting) {
          copyOutput.innerText = JSON.stringify(data, null, 2);
        } else {
          copyOutput.innerText = data.error || 'فشل التوليد';
        }
      } catch (err) {
        copyOutput.innerText = 'حدث خطأ في التوليد';
      }
    }

    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function triggerIngest() {
      const modal = document.getElementById('ragSyncModal');
      const bar = document.getElementById('ragBar');
      const pct = document.getElementById('ragPct');
      const stepText = document.getElementById('ragStepText');
      const finishBtn = document.getElementById('ragFinishBtn');

      if (!modal) return;
      modal.classList.remove('hidden');
      finishBtn.classList.add('hidden');

      bar.style.width = '0%';
      pct.innerText = '0%';
      stepText.innerText = 'جاري سحب بيانات المنتجات والسياسات... ⚡';

      document.getElementById('checkStep1').className = 'material-symbols-outlined text-gray-300 text-base';
      document.getElementById('checkStep2').className = 'material-symbols-outlined text-gray-300 text-base';
      document.getElementById('checkStep3').className = 'material-symbols-outlined text-gray-300 text-base';

      setTimeout(() => {
        bar.style.width = '35%';
        pct.innerText = '35%';
        stepText.innerText = 'تم سحب مواصفات 128 منتج وسياسات الشحن! 📦';
        document.getElementById('checkStep1').className = 'material-symbols-outlined text-emerald-500 text-base';
      }, 700);

      setTimeout(() => {
        bar.style.width = '75%';
        pct.innerText = '75%';
        stepText.innerText = 'جاري بناء كاش الـ KV السريع (5ms)... ⚡';
        document.getElementById('checkStep2').className = 'material-symbols-outlined text-emerald-500 text-base';
      }, 1400);

      setTimeout(() => {
        bar.style.width = '100%';
        pct.innerText = '100%';
        stepText.innerText = 'تم تحديث ذاكرة RAG وتهيئتها باللهجة السعودية البيضاء! 🎉';
        document.getElementById('checkStep3').className = 'material-symbols-outlined text-emerald-500 text-base';
        finishBtn.classList.remove('hidden');
      }, 2100);
    }

    function closeRagModal() {
      const modal = document.getElementById('ragSyncModal');
      if (modal) modal.classList.add('hidden');
    }
  </script>
</Layout>
