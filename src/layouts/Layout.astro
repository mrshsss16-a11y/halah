---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "أورا للتسويق | مستقبل التسويق الذكي - هالة AI OS",
  description = "الموظفة الرقمية الذكية المستنسخة لمتاجرك واستشاراتك التسويقية" 
} = Astro.props;
---

<!DOCTYPE html>
<html dir="rtl" lang="ar" data-theme="light">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  
  <!-- Fonts: DIN Next LT Arabic + Google Fonts (Readex Pro & Alexandria) -->
  <link href="https://fonts.cdnfonts.com/css/din-next-lt-arabic" rel="stylesheet"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&family=Readex+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  
  <!-- Material Symbols Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  
  <!-- GSAP & ScrollTrigger Animation Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Tailwind CSS CDN Fallback / Utility -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            aura: {
              bg: '#F8FAFC',
              card: '#FFFFFF',
              border: '#E2E8F0',
              text: '#0F1E36',
              muted: '#64748B',
              blue: '#0066FF',
              cyan: '#00C2FF',
              cyanLight: '#E0F2FE',
              navy: '#0A192F',
              navyDark: '#070D19'
            }
          },
          fontFamily: {
            sans: ['DIN Next LT Arabic', 'Readex Pro', 'Alexandria', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'DIN Next LT Arabic', 'Readex Pro', 'Alexandria', sans-serif;
      background-color: #F8FAFC;
      color: #0F1E36;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(0, 194, 255, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(0, 102, 255, 0.04) 0%, transparent 40%);
    }

    .aura-gradient-text {
      background: linear-gradient(135deg, #0A192F 0%, #0066FF 60%, #00C2FF 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .aura-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      box-shadow: 0 4px 20px -2px rgba(15, 30, 54, 0.04);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .aura-card:hover {
      box-shadow: 0 12px 30px -4px rgba(0, 102, 255, 0.08);
      border-color: #CBD5E1;
    }

    .aura-btn-primary {
      background: linear-gradient(135deg, #0052CC 0%, #0066FF 50%, #00C2FF 100%);
      color: #FFFFFF;
      box-shadow: 0 4px 16px 0 rgba(0, 102, 255, 0.3);
      transition: all 0.2s ease;
    }

    .aura-btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 22px 0 rgba(0, 102, 255, 0.45);
    }

    /* Floating Widget Glow */
    .floating-bot-glow {
      box-shadow: 0 10px 30px -5px rgba(0, 102, 255, 0.4);
      animation: floatPulse 3s ease-in-out infinite;
    }

    @keyframes floatPulse {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col relative">
  <slot />

  <!-- ── Floating Bottom Corner AI Agent Widget ───────────────── -->
  <aside class="fixed bottom-5 left-5 z-50 flex items-center gap-2">
    <a href="/login" class="bg-gradient-to-r from-slate-900 via-blue-900 to-slate-900 text-white px-4 py-3 rounded-2xl text-xs font-bold flex items-center gap-2.5 border border-blue-500/40 floating-bot-glow backdrop-blur-md transition hover:scale-105">
      <span class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></span>
      <span class="material-symbols-outlined text-cyan-300 text-lg">smart_toy</span>
      <div class="text-right">
        <span class="block text-[11px] font-bold text-cyan-200">أضف هالة لمتجرك الآن ⚡</span>
        <span class="block text-[9.5px] text-gray-300 font-normal">اصنع موظفتك الرقمية مجاناً</span>
      </div>
    </a>
  </aside>

  <script is:inline>
    // GSAP ScrollTrigger Global Register
    document.addEventListener("DOMContentLoaded", () => {
      if (window.gsap && window.ScrollTrigger) {
        gsap.registerPlugin(ScrollTrigger);

        // Animate elements with class .gsap-reveal
        gsap.utils.toArray('.gsap-reveal').forEach((el) => {
          gsap.fromTo(el, 
            { opacity: 0, y: 30 },
            { 
              opacity: 1, 
              y: 0, 
              duration: 0.8, 
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                toggleActions: "play none none none"
              }
            }
          );
        });
      }
    });
  </script>
</body>
</html>
