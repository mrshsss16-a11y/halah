# Cloudflare local cache + build output
.wrangler
dist
node_modules

# Astro generated types — regenerated on build
.astro

# Secrets — never commit
.env
.env*.local
.dev.vars

# نسخ قاعدة البيانات — تحتوي بيانات عملاء حقيقية (جوالات، إيميلات، محادثات)
backups

# Editor/agent tooling — not part of the app
.agents
skills-lock.json

# Skill packages (npx skills add) — editor tooling, not app code
.claude/skills

# graphify knowledge-graph output — regenerated from source, not app code
graphify-out

# نسخ عمل الوكلاء المتوازية (git worktree) — ليست جزءاً من الكود
.claude/worktrees/
