# N9 — HSTS على كل المسارات: بلا هذا الرأس تبقى أول زيارة على http قابلة
# للاعتراض والتحويل قبل أن يتدخل تحويل Cloudflare. سنة + كل النطاقات الفرعية.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://accounts.google.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://graph.facebook.com https://www.facebook.com; frame-src https://accounts.google.com https://www.facebook.com https://web.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Salla's Partner Portal embeds this exact page inside an iframe on the
# merchant's dashboard (s.salla.sa/embedded/app/...) — the global
# frame-ancestors 'none' + X-Frame-Options: DENY above block that outright.
# Cloudflare Pages COMBINES headers from every matching rule (confirmed: a
# request matching both "/*" and a more specific path gets both rules' headers,
# not an override) — so re-declaring Content-Security-Policy here would just
# add a SECOND csp header, and multiple CSP headers are enforced as an
# intersection (the strictest directive wins), leaving frame-ancestors 'none'
# in effect regardless. The "! " prefix explicitly deletes a header set by an
# earlier matching rule before redeclaring it — that's the only way to
# actually override, not just append.
/dashboard
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://accounts.google.com https://connect.facebook.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://graph.facebook.com https://www.facebook.com https://unpkg.com; frame-src https://accounts.google.com https://www.facebook.com https://web.facebook.com; frame-ancestors https://s.salla.sa https://*.salla.sa 'self'; base-uri 'self'; form-action 'self'

# Salla's iframe requests /dashboard.html; this project 308-redirects that to
# /dashboard (clean URL). Cover both in case that redirect behavior changes.
/dashboard.html
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://accounts.google.com https://connect.facebook.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://graph.facebook.com https://www.facebook.com https://unpkg.com; frame-src https://accounts.google.com https://www.facebook.com https://web.facebook.com; frame-ancestors https://s.salla.sa https://*.salla.sa 'self'; base-uri 'self'; form-action 'self'
