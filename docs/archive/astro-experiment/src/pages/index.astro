---
import Layout from '../layouts/Layout.astro';
import NavHeader from '../components/NavHeader.astro';
import KpiGrid from '../components/KpiGrid.astro';
import PlatformCards from '../components/PlatformCards.astro';
import ChatSandbox from '../components/ChatSandbox.astro';
import SeoStudio from '../components/SeoStudio.astro';
import BookingsTable from '../components/BookingsTable.astro';
---

<Layout title="أورا للتسويق | مستقبل التسويق الذكي - هالة AI OS">

  <!-- ── Top Header Navigation ──────────────────────────────────── -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-gray-200 px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-900 to-blue-600 text-white flex items-center justify-center font-bold text-xl shadow-md">
          أ
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-lg text-gray-900 tracking-tight">أورا للتسويق</span>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">Aura Marketing</span>
          </div>
          <p class="text-xs text-gray-500 font-medium">مستقبل التسويق الذكي | The Future of Marketing Intelligence</p>
        </div>
      </div>

      <!-- Quick Nav Links & CTA -->
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 px-4 py-2.5 rounded-xl border border-blue-200 transition flex items-center gap-1.5">
          <span class="material-symbols-outlined text-base">dashboard</span>
          <span>لوحة تحكم التاجر</span>
        </a>
        <a href="#instantAgentBox" class="aura-btn-primary px-4.5 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2">
          <span>اصنع بوتك مجاناً</span>
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

    </div>
  </header>

  <!-- ── Main Content Container ────────────────────────────────── -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-6 space-y-16 my-4">

    <!-- ── 1. Hero Section ──────────────────────────────────────── -->
    <section class="text-center max-w-4xl mx-auto space-y-6 pt-4 gsap-reveal">
      
      <div class="inline-flex items-center gap-2 text-xs font-bold text-blue-800 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full shadow-sm">
        <span>✨ من الإبداع إلى الذكاء | From Creativity to Intelligence</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold text-gray-900 leading-tight tracking-tight">
        أهلاً بك في منصة <span class="aura-gradient-text font-black">هالة أورا</span>.. <br class="hidden sm:block"/>
        ضع رابط متجرك واصنع موظفتك الذكية في 3 ثوانٍ 🚀
      </h1>

      <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-2xl mx-auto">
        ضع رابط متجرك الإلكتروني، وسيقوم النظام بسحب بياناتك تلقائياً وبناء موظفتك الرقمية المستنسخة لترد على عملائك بلهجة سعودية خاطفة وتسترد سلاتك المتروكة!
      </p>

    </section>

    <!-- ── 2. Perplexity-Style Instant Agent Search Engine ───────── -->
    <section id="instantAgentBox" class="aura-card rounded-3xl p-8 bg-gradient-to-l from-blue-600/5 via-white to-white border-blue-200 max-w-4xl mx-auto shadow-lg space-y-4 gsap-reveal">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full">محرك التوليد الفوري (Instant Agent Generator)</span>
        <h2 class="text-xl md:text-2xl font-bold text-gray-900">ضع رابط متجرك واكتشف موظفتك الرقمية الآن ⚡</h2>
        <p class="text-xs text-gray-500 max-w-xl mx-auto">
          النظام يسحب اسمك ومنتجاتك وسياستك تلقائياً ويصنع لك بوت يتكلم مع عملائك وهو عارف متجرك 100%!
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 max-w-2xl mx-auto bg-gray-50 p-2.5 rounded-2xl border border-gray-200">
        <div class="flex items-center gap-2 w-full px-3">
          <span class="material-symbols-outlined text-blue-600 text-xl">store</span>
          <input id="storeUrlInput" type="text" placeholder="أدخل رابط متجرك (مثال: salla.sa/mystore أو brand.com)" class="w-full bg-transparent text-xs font-medium text-gray-900 focus:outline-none placeholder:text-gray-400 py-2.5"/>
        </div>
        <button onclick="generateInstantAgent()" class="w-full sm:w-auto aura-btn-primary px-6 py-3 rounded-xl text-xs font-bold shrink-0 flex items-center justify-center gap-2 shadow-md">
          <span>اصنع بوت متجرك مجاناً</span>
          <span class="material-symbols-outlined text-base">auto_awesome</span>
        </button>
      </div>

      <!-- Agent Generated Notification Toast -->
      <div id="agentSuccessToast" class="hidden bg-emerald-50 border border-emerald-200 p-4 rounded-2xl text-emerald-800 text-xs font-bold flex items-center justify-between gap-4 max-w-2xl mx-auto shadow-sm">
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-emerald-600 text-xl">check_circle</span>
          <span id="toastText">تم سحب البيانات وإنشاء موظفة متجرك بنجاح! 🎉</span>
        </div>
        <a href="#sandboxDemo" class="bg-emerald-600 text-white px-3 py-1.5 rounded-lg text-[11px] font-bold hover:bg-emerald-700 transition">
          جرب التحدث معها الآن ➔
        </a>
      </div>
    </section>

    <!-- ── 3. Trust & Platform Integrations Bar ─────────────────── -->
    <section class="aura-card rounded-3xl p-7 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white space-y-6 shadow-xl gsap-reveal">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <span class="text-xs font-bold text-cyan-300 bg-cyan-950 border border-cyan-800 px-3 py-1 rounded-full">1-Click Platform Integrations</span>
        <h2 class="text-2xl font-bold">اربط متجرك بضغطة زر.. ولا تشيل هم!</h2>
        <p class="text-xs text-gray-300 leading-relaxed">
          تكامل سلس ومباشر مع منصات سلة وزد وتطبيقات الواتساب الرسمية المعتمدة من ميتا.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto pt-2">
        <a href="/api/auth/salla/install" class="bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-200 border border-emerald-700/50 p-5 rounded-2xl text-center space-y-2 transition">
          <span class="material-symbols-outlined text-3xl text-emerald-400">storefront</span>
          <h3 class="font-bold text-sm">متجر سلة (Salla)</h3>
          <p class="text-[11px] text-emerald-300/80">ربط OAuth بضغطة زر واحدة</p>
        </a>

        <a href="/api/auth/zid/install" class="bg-purple-950/60 hover:bg-purple-900/80 text-purple-200 border border-purple-700/50 p-5 rounded-2xl text-center space-y-2 transition">
          <span class="material-symbols-outlined text-3xl text-purple-400">shopping_bag</span>
          <h3 class="font-bold text-sm">متجر زد (Zid)</h3>
          <p class="text-[11px] text-purple-300/80">ربط Dual-Header Auth المزدوج</p>
        </a>

        <div class="bg-blue-950/60 text-blue-200 border border-blue-700/50 p-5 rounded-2xl text-center space-y-2">
          <span class="material-symbols-outlined text-3xl text-blue-400">chat</span>
          <h3 class="font-bold text-sm">واتساب الأعمال الرسمي</h3>
          <p class="text-[11px] text-blue-300/80">تراخيص Meta Cloud API معتمدة</p>
        </div>
      </div>
    </section>

    <!-- ── 4. The WOW Factor: Live Interactive Sandbox Chat ──────── -->
    <section id="sandboxDemo" class="space-y-4 gsap-reveal">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full">نقطة الأبصار اللحظية (The WOW Moment)</span>
        <h2 class="text-2xl font-bold text-gray-900">اختبر الرد التفاعلي لموظفة متجرك الآن 💬</h2>
        <p class="text-xs text-gray-500">البوت جاهز ومعرف لخدمة عملاء متجرك بسرعة رد خاطفة (< 1ms)</p>
      </div>

      <ChatSandbox />
    </section>



    <!-- ── 6. Guaranteed Results & Metrics ──────────────────────── -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center gsap-reveal">
      <div class="aura-card rounded-2xl p-6 space-y-2 border-emerald-200 bg-emerald-50/30">
        <span class="text-3xl font-black text-emerald-600">15% - 25%</span>
        <h3 class="font-bold text-sm text-gray-900">نسبة استرداد السلات المتروكة</h3>
        <p class="text-xs text-gray-500">مبيعات محققة بالريال السعودي بدلاً من ضياعها</p>
      </div>

      <div class="aura-card rounded-2xl p-6 space-y-2 border-blue-200 bg-blue-50/30">
        <span class="text-3xl font-black text-blue-600">70% - 80%</span>
        <h3 class="font-bold text-sm text-gray-900">تقليص تكاليف الدعم الفني</h3>
        <p class="text-xs text-gray-500">توفير رواتب موظفي الدعم بالرد التلقائي السريع</p>
      </div>

      <div class="aura-card rounded-2xl p-6 space-y-2 border-purple-200 bg-purple-50/30">
        <span class="text-3xl font-black text-purple-600">+30%</span>
        <h3 class="font-bold text-sm text-gray-900">زيادة الزيارات العضوية SEO</h3>
        <p class="text-xs text-gray-500">أوصاف منتجات تتصدر نتائج بحث محركات البحث</p>
      </div>
    </section>

    <!-- ── 7. FAQ Accordion ──────────────────────────────────────── -->
    <section class="max-w-4xl mx-auto space-y-6 pt-4 gsap-reveal">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-gray-900">الأسئلة الشائعة عن هالة أورا</h2>
        <p class="text-xs text-gray-500">إجابات دقيقة لجميع استفساراتك قبل البدء</p>
      </div>

      <div class="space-y-4">
        <details class="aura-card rounded-2xl p-5 cursor-pointer group">
          <summary class="font-bold text-sm text-gray-900 flex items-center justify-between list-none">
            <span>وش هي منصة هالة أورا؟</span>
            <span class="material-symbols-outlined text-blue-600 group-open:rotate-180 transition">expand_more</span>
          </summary>
          <p class="text-xs text-gray-600 mt-3 leading-relaxed">
            هالة أورا هي نظام تشغيل ذكي (Hala AI OS) تابع لشركة أورا للتسويق، مصمم ليساعد أصحاب المتاجر الإلكترونية على زيادة مبيعاتهم وتحسين تجربة عملائهم باستخدام أحدث تقنيات الذكاء الاصطناعي.
          </p>
        </details>

        <details class="aura-card rounded-2xl p-5 cursor-pointer group">
          <summary class="font-bold text-sm text-gray-900 flex items-center justify-between list-none">
            <span>هل هالة تدعم المتاجر على سلة وزد؟</span>
            <span class="material-symbols-outlined text-blue-600 group-open:rotate-180 transition">expand_more</span>
          </summary>
          <p class="text-xs text-gray-600 mt-3 leading-relaxed">
            أكيد! هالة أورا تدعم الربط المباشر مع منصات سلة وزد بضغطة زر، عشان تبدأ تستفيد من ميزاتها بدون أي تعقيدات برمجية.
          </p>
        </details>

        <details class="aura-card rounded-2xl p-5 cursor-pointer group">
          <summary class="font-bold text-sm text-gray-900 flex items-center justify-between list-none">
            <span>كيف تشتغل ميزة استرداد السلات المتروكة؟</span>
            <span class="material-symbols-outlined text-blue-600 group-open:rotate-180 transition">expand_more</span>
          </summary>
          <p class="text-xs text-gray-600 mt-3 leading-relaxed">
            النظام يتعرف على العملاء اللي أضافوا منتجات للسلة وما كملوا الدفع، ويرسل لهم رسائل واتساب تذكيرية بأسلوب لطيف ومحفز، تزيد من فرصة رجوعهم وإتمام الشراء.
          </p>
        </details>
      </div>
    </section>

    <!-- ── 8. Final Call to Action ───────────────────────────────── -->
    <section class="aura-card rounded-3xl p-10 text-center bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white space-y-6 shadow-2xl gsap-reveal">
      <div class="space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">جاهز تنقل متجرك من الإبداع إلى الذكاء؟</h2>
        <p class="text-blue-200 text-xs md:text-sm leading-relaxed">
          لا تخلّي متجرك يعتمد على الطرق التقليدية. انضم لمستقبل التسويق الذكي مع هالة أورا اليوم، وشوف أرقام مبيعاتك ترتفع.
        </p>
      </div>

      <div class="flex justify-center">
        <a href="/login" class="aura-btn-primary px-8 py-4 rounded-2xl text-sm font-bold flex items-center gap-2 shadow-xl">
          <span>انضم لـ هالة أورا الآن!</span>
          <span class="material-symbols-outlined text-lg">rocket_launch</span>
        </a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500 space-y-1">
    <p>حقوق الطبع والنشر © 2026 <strong>أورا للتسويق (Aura Marketing)</strong> — جميع الحقوق محفوظة.</p>
    <p class="text-gray-400">مستقبل التسويق الذكي | From Creativity to Intelligence</p>
  </footer>

  <script is:inline>
    async function generateInstantAgent() {
      const storeUrl = document.getElementById('storeUrlInput').value.trim();
      if (!storeUrl) {
        alert('أدخل رابط متجرك الإلكتروني أولاً.');
        return;
      }

      const toast = document.getElementById('agentSuccessToast');
      const toastText = document.getElementById('toastText');
      toastText.innerText = 'جاري سحب بيانات متجرك وبناء موظفتك الرقمية بالذكاء الاصطناعي... ⚡';
      toast.classList.remove('hidden');

      try {
        const res = await fetch('/api/store/instant_agent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ storeUrl })
        });
        const data = await res.json();
        
        if (data.ok) {
          toastText.innerText = `تم سحب بيانات متجرك بنجاح! ⚡ تم إنشاء (${data.agentName}) وتجهيزها للرد على عملائك! 🎉`;
          
          // Pre-fill Sandbox store selector
          const storeSelect = document.getElementById('storeSelector');
          if (storeSelect) {
            storeSelect.value = data.storeId;
          }

          // Scroll directly to Chat Sandbox Demo
          setTimeout(() => {
            const demo = document.getElementById('sandboxDemo');
            if (demo) demo.scrollIntoView({ behavior: 'smooth' });
          }, 1200);
        } else {
          toastText.innerText = data.error || 'فشل سحب البيانات';
        }
      } catch (err) {
        toastText.innerText = 'حدث خطأ أثناء السحب، تم إنشاء البوت بالبيانات الافتراضية!';
      }
    }

    function updateRoiCalc() {
      const carts = Number(document.getElementById('cartsInput').value);
      const price = Number(document.getElementById('priceInput').value);

      document.getElementById('cartsVal').innerText = `${carts} سلة`;
      document.getElementById('priceVal').innerText = `${price} ريال`;

      const recoveredSAR = Math.round(carts * price * 0.20);
      document.getElementById('roiResult').innerText = `+ ${recoveredSAR.toLocaleString('ar-SA')} ريال سعودي`;
    }
  </script>

</Layout>
