---
import Layout from '../layouts/Layout.astro';
import NavHeader from '../components/NavHeader.astro';
import BookingsTable from '../components/BookingsTable.astro';
---

<Layout title="أورا للتسويق | حجز الاستشارات وتذاكر AURA - هالة AI OS">
  <NavHeader />

  <main class="flex-1 max-w-7xl w-full mx-auto p-6 space-y-8 my-4">
    <!-- Header Banner -->
    <div class="aura-card rounded-2xl p-7 bg-gradient-to-l from-blue-50/80 via-white to-white border-blue-100 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-sm gsap-reveal">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-blue-700 bg-blue-100/70 px-3 py-1 rounded-md">
          <span>🎯 بوابة الاستشارات والخدمات المخصصة | AURA Consultations</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">
          حجز الجلسات الاستشارية وتتبع تذاكر <span class="aura-gradient-text font-black">AURA-XXXXX</span>
        </h1>
        <p class="text-gray-600 text-xs md:text-sm leading-relaxed max-w-2xl">
          احجز موعد استشارة تسويقية مخصصة مع فريق خبراء أورا للتسويق، مع تذكير تلقائي بالواتساب يرسل لك قبل الفتحة بـ 30 دقيقة.
        </p>
      </div>

      <a href="/dashboard" class="bg-white border border-blue-200 text-blue-700 hover:bg-blue-50 px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 shadow-sm transition shrink-0">
        <span class="material-symbols-outlined text-base">dashboard</span>
        <span>العودة للوحة التحكم</span>
      </a>
    </div>

    <!-- Consultation Booking & Tickets Widget -->
    <div class="gsap-reveal">
      <BookingsTable />
    </div>
  </main>

  <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500 space-y-1 mt-12">
    <p>حقوق الطبع والنشر © 2026 <strong>أورا للتسويق (Aura Marketing)</strong> — جميع الحقوق محفوظة.</p>
    <p class="text-gray-400">مستقبل التسويق الذكي | From Creativity to Intelligence</p>
  </footer>
</Layout>
