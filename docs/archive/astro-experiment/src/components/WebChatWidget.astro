---
---
<!-- Floating Web Chat Widget Component for Merchants -->
<div id="webChatWidgetContainer" class="fixed bottom-6 right-6 z-50">
  
  <!-- Toggle Bubble Button -->
  <button onclick="toggleWebChatWidget()" class="w-14 h-14 rounded-full bg-black text-white shadow-2xl flex items-center justify-center hover:scale-105 transition-all border border-slate-700 group">
    <span id="chatWidgetIcon" class="material-symbols-outlined text-2xl group-hover:rotate-12 transition">chat</span>
  </button>

  <!-- Floating Chat Window (Hidden by Default) -->
  <div id="webChatWindow" class="hidden absolute bottom-18 right-0 w-80 sm:w-96 bg-white border border-slate-300 rounded-3xl shadow-2xl overflow-hidden flex flex-col text-right">
    
    <!-- Widget Header -->
    <div class="bg-black text-white p-4 flex items-center justify-between border-b border-slate-800">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-white text-black font-black text-xs flex items-center justify-center">
          هـ
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h4 class="font-bold text-xs text-white">موظفة المتجر الرقمية</h4>
            <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-200 border border-slate-700">🇸🇦 موثق للأعمال</span>
          </div>
          <span class="text-[10px] text-slate-300 flex items-center gap-1 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
            <span>رد آلي بلهجة سعودية بيضاء</span>
          </span>
        </div>
      </div>
      <button onclick="toggleWebChatWidget()" class="text-slate-300 hover:text-white font-bold text-base">✕</button>
    </div>

    <!-- Messages Body -->
    <div id="webChatMessages" class="p-4 h-64 overflow-y-auto space-y-3 bg-slate-50 text-xs text-black">
      <div class="bg-white border border-slate-300 p-3 rounded-2xl max-w-[88%] shadow-sm leading-relaxed">
        أهلاً بك! 👋 أنا موظفة المتجر الرقمية.. اكتب أي سؤال عن منتجاتنا وسياسات الشحن والطلب، وأنا أجاوبك فوراً!
      </div>
    </div>

    <!-- Input Footer -->
    <form onsubmit="handleWebChatMessageSubmit(event)" class="p-3 bg-white border-t border-slate-200 flex items-center gap-2">
      <input id="webChatInput" type="text" placeholder="اكتب سؤالك هنا..." class="w-full bg-slate-50 border border-slate-300 text-xs rounded-xl p-2.5 text-black focus:outline-none focus:border-black font-medium"/>
      <button type="submit" class="bg-black text-white p-2.5 rounded-xl hover:bg-slate-800 transition shrink-0">
        <span class="material-symbols-outlined text-base">send</span>
      </button>
    </form>
  </div>

</div>

<script is:inline>
  function toggleWebChatWidget() {
    const win = document.getElementById('webChatWindow');
    const icon = document.getElementById('chatWidgetIcon');
    if (!win) return;
    if (win.classList.contains('hidden')) {
      win.classList.remove('hidden');
      if (icon) icon.innerText = 'close';
    } else {
      win.classList.add('hidden');
      if (icon) icon.innerText = 'chat';
    }
  }

  async function handleWebChatMessageSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('webChatInput');
    const msg = input?.value?.trim();
    if (!msg) return;

    const stream = document.getElementById('webChatMessages');
    stream.innerHTML += `
      <div class="flex justify-end">
        <div class="bg-black text-white p-2.5 rounded-2xl max-w-[85%] font-medium">
          ${msg}
        </div>
      </div>
    `;
    input.value = '';
    stream.scrollTop = stream.scrollHeight;

    try {
      const res = await fetch('/api/store/sandbox', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ storeId: 'demo', message: msg, dialect: 'saudi_white' })
      });
      const data = await res.json();
      const reply = data?.reply || 'أهلاً بك! نسعد بخدمتك في أي وقت.';

      stream.innerHTML += `
        <div class="flex justify-start">
          <div class="bg-white border border-slate-300 text-black p-2.5 rounded-2xl max-w-[85%] shadow-sm leading-relaxed font-medium">
            ${reply}
            <span class="block text-[9px] text-slate-400 font-mono mt-1">سرعة الرد: ${data?.latency || '< 1ms'}</span>
          </div>
        </div>
      `;
      stream.scrollTop = stream.scrollHeight;
    } catch (err) {
      console.error('Widget error:', err);
    }
  }
</script>
